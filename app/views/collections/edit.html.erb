<%# Modifier une collection (style « Pilule ») : formulaire, puis la suppression %>
<div class="min-h-screen bg-paper px-5 pt-[68px] pb-24 text-ink">
  <%= link_to collection_path(@collection),
      class: "inline-flex max-w-full items-center gap-1 h-10 pl-2.5 pr-3.5 rounded-full bg-white border-[1.5px] border-stone-200 text-sm font-bold" do %>
    <svg aria-hidden="true" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M15 19l-7-7 7-7"/></svg>
    <span class="truncate"><%= @collection.title_was %></span>
  <% end %>
  <h1 class="mt-4 mb-6 text-[30px] font-extrabold tracking-tight leading-none">Modifier la collection</h1>

  <%= render "form", collection: @collection %>

  <div class="mt-4">
    <%= link_to collection_path(@collection),
        data: { turbo_method: :delete, turbo_confirm: "Supprimer cette collection ? Cette action est irréversible." },
        class: "w-full h-14 flex items-center justify-center gap-2 rounded-full border-[1.5px] border-red-200 bg-white text-red-700 text-base font-bold active:scale-95 transition-transform duration-150" do %>
      <svg aria-hidden="true" class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      Supprimer la collection
    <% end %>
  </div>
</div>
