<%# Profil (style « Pilule ») : en haut, sur fond lilas, l'avatar, le nom, le type de compte et trois chiffres ;
    dessous, les demandes d'amis reçues, les amis (et l'ajout d'un ami), l'adresse ; en bas, le compte et la déconnexion %>
<% card = "bg-white rounded-3xl shadow-[0_1px_2px_rgba(30,27,46,0.06)]" %>
<% small_pill = "h-8 px-3 rounded-full border-[1.5px] border-stone-200 bg-white text-xs font-bold text-stone-600 hover:text-ink" %>
<div class="min-h-screen bg-paper pt-14 pb-24 text-ink">

  <section class="bg-lilac rounded-b-[36px] px-5 pt-6 pb-6 flex flex-col items-center text-center gap-1.5">
    <% if current_user.avatar_url %>
      <img src="<%= current_user.avatar_url %>" alt="" class="w-[84px] h-[84px] rounded-full object-cover border-4 border-white">
    <% else %>
      <span aria-hidden="true" class="w-[84px] h-[84px] rounded-full bg-ink text-white text-[34px] font-extrabold flex items-center justify-center border-4 border-white">
        <%= current_user.email[0].upcase %>
      </span>
    <% end %>
    <h1 class="mt-1.5 text-[28px] font-extrabold tracking-tight leading-none break-all"><%= current_user.email.split("@").first %></h1>
    <p class="text-sm text-[#4c3d6b] break-all"><%= current_user.email %></p>
    <%# Type de compte : ce à quoi l'utilisateur a droit (Free : pas d'IA ni de scan payant) %>
    <% role_style = { "admin" => "bg-ink text-white", "premium" => "bg-purple-700 text-white", "free" => "bg-white text-stone-700" } %>
    <span class="mt-1 h-7 px-3 rounded-full text-xs font-bold flex items-center gap-1 <%= role_style[current_user.role] %>">
      <% unless current_user.free? %>
        <svg aria-hidden="true" class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z"/></svg>
      <% end %>
      <%= t("roles.#{current_user.role}", default: current_user.role.capitalize) %>
    </span>

    <% items_total = @collections_owned.sum { |c| c.items.size } + @collections_shared.sum { |c| c.items.size } %>
    <dl class="mt-4 w-full grid grid-cols-3 gap-2">
      <% [ [ @collections_owned.size, @collections_owned.size > 1 ? "collections" : "collection" ],
           [ items_total, items_total > 1 ? "items" : "item" ],
           [ @collections_shared.size, @collections_shared.size > 1 ? "partagées" : "partagée" ] ].each do |value, label| %>
        <div class="bg-white rounded-[20px] py-2.5 px-1.5 flex flex-col-reverse">
          <dt class="text-xs text-stone-600"><%= label %></dt>
          <dd class="text-[22px] font-extrabold leading-tight"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <div class="px-5 pt-5 flex flex-col gap-6">

    <%# Demandes reçues : en premier, c'est ce qui attend une réponse %>
    <% if @pending_friendships.any? %>
      <div>
        <h2 class="mb-2 text-[17px] font-extrabold">Demandes reçues</h2>
        <div class="flex flex-col gap-2">
          <% @pending_friendships.each do |friendship| %>
            <div class="<%= card %> px-3.5 py-3 flex items-center gap-3">
              <%= person_avatar(friendship.requester) %>
              <div class="flex-1 min-w-0">
                <p class="text-[15px] font-bold truncate"><%= friendship.requester.email.split("@").first %></p>
                <p class="text-xs text-stone-600 truncate"><%= friendship.requester.email %></p>
              </div>
              <%= button_to "Accepter", accept_friendship_path(friendship), method: :patch,
                  class: "h-9 px-3.5 rounded-full bg-ink text-white text-[13px] font-bold" %>
              <%= button_to reject_friendship_path(friendship), method: :patch,
                  aria: { label: "Refuser la demande de #{friendship.requester.email.split('@').first}" },
                  class: "w-9 h-9 rounded-full border-[1.5px] border-stone-200 bg-white text-stone-600 flex items-center justify-center" do %>
                <svg aria-hidden="true" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Amis, demandes envoyées (en attente), puis l'ajout d'un ami par e-mail %>
    <div>
      <h2 class="mb-2 text-[17px] font-extrabold">Mes amis</h2>
      <% if @friends.any? || @sent_friendships.any? %>
        <div class="<%= card %> px-3.5 py-1 divide-y divide-stone-100">
          <% @friends.each do |friend| %>
            <div class="py-2.5 flex items-center gap-3">
              <%# Avatar et nom : vers ses souhaits (lecture seule) %>
              <%= link_to friend_wishes_path(friend), class: "flex-1 min-w-0 flex items-center gap-3" do %>
                <%= person_avatar(friend) %>
                <span class="flex-1 min-w-0">
                  <span class="block text-[15px] font-bold truncate"><%= friend.email.split("@").first %></span>
                  <span class="block text-xs text-purple-700 font-semibold">Voir ses souhaits</span>
                </span>
              <% end %>
              <%= button_to "Retirer", friendship_path(@friendships_by_friend[friend.id]), method: :delete, class: small_pill %>
            </div>
          <% end %>
          <% @sent_friendships.each do |friendship| %>
            <div class="py-2.5 flex items-center gap-3">
              <%= person_avatar(friendship.receiver) %>
              <div class="flex-1 min-w-0">
                <p class="text-[15px] font-bold truncate"><%= friendship.receiver.email.split("@").first %></p>
                <p class="text-xs text-stone-600">En attente…</p>
              </div>
              <%= button_to "Annuler", friendship_path(friendship), method: :delete, class: small_pill %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="px-1 text-sm text-stone-600">Aucun ami pour l'instant : ajoute-en un avec son e-mail.</p>
      <% end %>

      <%= form_with url: friendships_path, method: :post, class: "mt-2.5 flex gap-2" do |f| %>
        <%= f.email_field :receiver_email, placeholder: "E-mail de ton ami·e", aria: { label: "E-mail de ton ami·e" },
            class: "flex-1 min-w-0 h-12 rounded-full border-[1.5px] border-stone-200 bg-white px-[18px] text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200" %>
        <%= f.submit "Ajouter", class: "h-12 px-[18px] rounded-full bg-purple-700 text-white text-[15px] font-bold cursor-pointer" %>
      <% end %>

      <%# Souhaits : ce que les amis voient de mes souhaits. Cadre Turbo : la page ne remonte pas en haut au changement %>
      <%= turbo_frame_tag "wishes_visibility" do %>
        <%= form_with model: current_user, url: update_wishes_visibility_path, method: :patch, data: { controller: "auto-submit" },
            class: "mt-3" do |f| %>
          <label class="flex items-center justify-between gap-4 bg-white rounded-3xl px-5 py-4 cursor-pointer shadow-[0_1px_2px_rgba(30,27,46,0.06)]">
            <span>
              <span class="block text-[15px] font-bold">Mes amis voient mes souhaits</span>
              <span class="block text-xs text-stone-600">Les jeux que tu cherches : idées de cadeaux, trouvailles en brocante…</span>
            </span>
            <%= f.check_box :wishes_visible_to_friends, role: "switch", data: { action: "change->auto-submit#submit" },
                class: "appearance-none shrink-0 w-11 h-[26px] rounded-full bg-gray-300 relative cursor-pointer transition-colors checked:bg-purple-700 " \
                       "before:content-[''] before:absolute before:top-[3px] before:left-[3px] before:w-5 before:h-5 before:rounded-full before:bg-white " \
                       "before:transition-transform checked:before:translate-x-[18px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600" %>
          </label>
        <% end %>
      <% end %>
    </div>

    <%# Adresse : sert à trouver les vide-greniers proches (Mon Carnet) %>
    <div>
      <h2 class="mb-2 text-[17px] font-extrabold">Mon adresse</h2>
      <%= turbo_frame_tag "address" do %>
        <% if current_user.address.present? %>
          <div class="<%= card %> px-4 py-3.5 flex items-center gap-3">
            <span aria-hidden="true" class="w-10 h-10 shrink-0 rounded-full bg-lilac text-purple-700 flex items-center justify-center">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            </span>
            <p class="flex-1 min-w-0 text-sm font-medium break-words"><%= current_user.address %></p>
            <%= link_to "Modifier", edit_address_path, class: "#{small_pill} flex items-center" %>
          </div>
        <% else %>
          <%= link_to edit_address_path,
              class: "w-full h-14 flex items-center justify-center gap-2 rounded-full border-[1.5px] border-dashed border-stone-400 text-stone-700 text-[15px] font-bold" do %>
            <svg aria-hidden="true" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Ajouter mon adresse
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Compte (e-mail, mot de passe, suppression), déconnexion, crédits des sources de données %>
    <div class="flex flex-col gap-2.5 pt-1">
      <%= link_to edit_user_registration_path,
          class: "h-14 rounded-full border-[1.5px] border-stone-300 bg-white text-base font-bold flex items-center justify-center gap-2" do %>
        <svg aria-hidden="true" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
        Mon compte
      <% end %>
      <%= link_to "Se déconnecter", destroy_user_session_path, data: { turbo_method: :delete },
          class: "h-14 rounded-full border-[1.5px] border-red-200 bg-white text-red-700 text-base font-bold flex items-center justify-center" %>
      <%= link_to "Crédits", credits_path, class: "self-center p-2 text-xs text-gray-500 hover:text-purple-800" %>
    </div>
  </div>
</div>
