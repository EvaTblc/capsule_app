<%# Cadre des écrans d'entrée : fond lilas à pois, autocollants d'objets de collection, logo, puis la carte du formulaire.
    Usage : render layout: "shared/entry", locals: { tagline: "…" } do … end %>
<% tagline = local_assigns.fetch(:tagline, nil) %>
<div class="relative min-h-dvh overflow-x-hidden bg-lilac font-display text-ink">
  <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(#d8c4fb_1.5px,transparent_1.5px)] bg-size-[18px_18px]"></div>

  <div class="relative mx-auto w-full max-w-sm px-4 pt-[74px] pb-8 flex flex-col items-center">
    <%= render "shared/entry_stickers" %>

    <%= image_tag "logo.svg", alt: "", class: "relative w-[104px] h-[104px] -rotate-[8deg]" %>
    <p class="relative text-[50px] font-extrabold leading-[0.9] mt-0.5 tracking-[-0.01em]">capsule</p>
    <% if tagline %>
      <p class="relative mt-2 text-base font-semibold text-[#4c3d6b] text-center"><%= tagline %></p>
    <% end %>

    <div class="relative mt-7 w-full bg-white border-[2.5px] border-ink rounded-[26px] shadow-[6px_6px_0_var(--color-ink)] px-5 pt-5 pb-5 flex flex-col gap-3">
      <%= yield %>
    </div>
    <%= content_for(:entry_footer) %>
  </div>
</div>
