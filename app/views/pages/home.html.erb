<% content_for :entry_footer do %>
  <%= link_to "Crédits", credits_path, class: "relative mt-6 py-2 font-sans text-xs text-[#6b6478] hover:text-purple-800" %>
<% end %>

<%= render layout: "shared/entry", locals: { tagline: "Jeux, BD, vinyles, figurines… toute ta collec' au même endroit." } do %>
  <h1 class="text-[27px] font-extrabold leading-tight">Ta collec' dans ta poche</h1>
  <p class="font-sans text-sm text-[#3b3450]">Range, retrouve et partage tout ce que tu collectionnes.</p>

  <%= link_to "Connexion", new_user_session_path, class: "#{entry_button_class} mt-1 flex items-center justify-center" %>
  <p class="mt-1 text-center text-[15px] font-semibold text-[#3b3450]">
    Nouveau ici ? <%= link_to "Crée ta capsule", new_user_registration_path, class: entry_link_class %>
  </p>
<% end %>
