<%# Champ mot de passe des écrans d'entrée, avec le bouton œil pour afficher ce qu'on tape.
    Locaux : f, field, label, autocomplete, hint (facultatif, ex. « 6 caractères minimum »), autofocus (facultatif) %>
<div data-controller="password-toggle" class="<%= entry_field_class %> flex items-center pr-0">
  <div class="flex-1 min-w-0">
    <div class="flex items-baseline justify-between gap-2 pr-1">
      <%= f.label field, label, class: entry_label_class %>
      <% if local_assigns[:hint] %>
        <span class="text-xs font-semibold text-[#6b6478]"><%= hint %></span>
      <% end %>
    </div>
    <%= f.password_field field, autocomplete: autocomplete, autofocus: local_assigns.fetch(:autofocus, false),
        placeholder: "••••••••", class: entry_input_class, data: { password_toggle_target: "input" } %>
  </div>
  <button type="button" data-password-toggle-target="button" data-action="password-toggle#toggle"
          aria-label="Afficher le mot de passe" aria-pressed="false"
          class="w-12 h-12 shrink-0 flex items-center justify-center text-[#4c3d6b]">
    <svg aria-hidden="true" class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>
</div>
