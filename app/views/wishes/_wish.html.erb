<%# Une ligne de souhait : titre ; plateforme, édition et auteur (collection partagée) ; prix maximum %>
<% details = [ wish.platform, wish.edition ] %>
<% details << "ajouté par #{wish.author.email.split('@').first}" if show_author && wish.author %>
<%= link_to edit_collection_wish_path(wish.collection_id, wish), class: "px-4 py-3 flex items-center gap-3 active:bg-stone-50" do %>
  <span aria-hidden="true" class="w-10 h-10 shrink-0 rounded-full bg-lilac text-purple-700 flex items-center justify-center">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg>
  </span>
  <div class="flex-1 min-w-0">
    <p class="text-[15px] font-bold truncate"><%= wish.title %></p>
    <% if details.compact_blank.any? %>
      <p class="text-xs text-stone-600 truncate"><%= details.compact_blank.join(" · ") %></p>
    <% end %>
  </div>
  <% if wish.max_price %>
    <span class="h-7 px-2.5 shrink-0 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center whitespace-nowrap">
      <span class="sr-only">Prix maximum :</span><span aria-hidden="true">≤</span>&nbsp;<%= wish_price(wish) %>
    </span>
  <% end %>
  <svg aria-hidden="true" class="w-4 h-4 shrink-0 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M9 5l7 7-7 7"/></svg>
<% end %>
