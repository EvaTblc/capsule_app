<%# Mes collections (style « Pilule ») : chaque collection est une capsule à la couleur de sa catégorie (ou avec sa photo
    de couverture en pastille), puis « Nouvelle collection » ; les derniers objets ajoutés dessous %>
<div class="min-h-screen bg-paper px-5 pt-20 pb-24 text-ink">

  <% if @collections.empty? %>
    <div class="flex flex-col items-center justify-center min-h-96 gap-4 text-center">
      <%= image_tag "logo.svg", alt: "", class: "w-24 h-24 -rotate-[8deg]" %>
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight mb-1">Aucune collection</h1>
        <p class="text-sm text-stone-600">Crée ta première collection pour commencer à cataloguer tes objets.</p>
      </div>
      <%= link_to new_collection_path, class: "#{entry_button_class} w-auto px-7" do %>
        <%= entry_button_content("Créer une collection") %>
      <% end %>
    </div>

  <% else %>
    <h1 class="text-[34px] font-extrabold tracking-tight leading-none">Mes collections</h1>
    <p class="mt-1.5 mb-5 text-[15px] text-stone-600">
      <%= items_count(@item_counts.values.sum) %> dans <%= @collections.size %> <%= @collections.size > 1 ? "capsules" : "capsule" %>
    </p>

    <div class="flex flex-col gap-2.5">
      <% @collections.each do |collection| %>
        <%= link_to collection_path(collection),
            class: "h-[76px] rounded-full #{collection_tint(collection.category)} flex items-center gap-3.5 pl-3 pr-6 active:scale-[0.98] transition-transform duration-150" do %>
          <span class="w-[52px] h-[52px] shrink-0 rounded-full bg-white overflow-hidden flex items-center justify-center">
            <% if collection.cover_image.attached? %>
              <%= image_tag collection.cover_image, alt: "", class: "w-full h-full object-cover" %>
            <% else %>
              <%= render "collections/icons/#{collection.category == 'books' ? 'book' : collection.category}" %>
            <% end %>
          </span>
          <span class="flex-1 min-w-0 text-lg font-extrabold tracking-tight truncate"><%= collection.title %></span>
          <%# Nombre seul à l'écran, « 12 items » pour les lecteurs d'écran %>
          <span class="shrink-0 text-[15px] font-bold text-stone-700" aria-hidden="true"><%= @item_counts.fetch(collection.id, 0) %></span>
          <span class="sr-only"><%= items_count(@item_counts.fetch(collection.id, 0)) %></span>
        <% end %>
      <% end %>

      <%= link_to new_collection_path,
          class: "h-16 rounded-full border-[1.5px] border-dashed border-stone-400 text-stone-700 text-[15px] font-bold flex items-center justify-center gap-2 hover:bg-white" do %>
        <svg aria-hidden="true" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Nouvelle collection
      <% end %>
    </div>

    <%# Récemment ajouté : les derniers objets, toutes collections confondues %>
    <% if @recent_items.any? %>
      <h2 class="mt-8 mb-3 text-base font-extrabold">Récemment ajouté</h2>
      <div class="flex gap-3 overflow-x-auto -mx-5 px-5 pb-2 [scrollbar-width:none]">
        <% @recent_items.each do |item| %>
          <%= link_to collection_item_path(item.collection, item), class: "shrink-0 w-28" do %>
            <div class="mb-2"><%= render "items/tile", item: item %></div>
            <p class="text-xs font-bold truncate"><%= item.title %></p>
            <p class="text-xs text-stone-600 truncate"><%= item.collection.title %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

</div>
