<%# Vignette d'un item, au format 3:4 et à la largeur de son conteneur : ta photo, sinon la jaquette IGDB (jeu relié
    au catalogue), sinon la vignette générique de son type (items/tiles/_xxx). Badge seulement pour une info positive.
    Locals : item ; compact (liste, ~44 px de large) : sans texte, juste la couleur et l'icône du type %>
<% compact = local_assigns.fetch(:compact, false) %>
<% cover = item_cover_url(item, size: compact ? :cover_small : :cover_big) %>
<% badge = item_tile_badge(item) unless compact %>
<div class="relative w-full aspect-[3/4] <%= compact ? 'rounded-lg' : 'rounded-2xl' %> overflow-hidden bg-stone-100">
  <% if item.images.attached? %>
    <% photo = item.images.first %>
    <%# Vignette réduite (Item :thumb) ; photo d'origine seulement si son format ne se redimensionne pas %>
    <%= image_tag photo.variable? ? photo.variant(:thumb) : photo, alt: "", loading: "lazy", class: "absolute inset-0 w-full h-full object-cover" %>
  <% elsif cover %>
    <%# Jaquette IGDB du jeu (catalogue), affichée depuis leur serveur d'images %>
    <%= image_tag cover, alt: "", loading: "lazy", referrerpolicy: "no-referrer", class: "absolute inset-0 w-full h-full object-cover" %>
  <% elsif compact %>
    <div class="absolute inset-0 flex items-center justify-center <%= Item::ITEM_TYPE_STYLES[item.item_detailable_type] %>">
      <%= render "collections/icons/#{Item::TYPE_TO_ICON.fetch(item.item_detailable_type, 'other')}" %>
    </div>
  <% else %>
    <% type = item.item_detailable_type.to_s.delete_suffix("Detail").underscore %>
    <% if lookup_context.exists?("items/tiles/#{type}", [], true) %>
      <%= render "items/tiles/#{type}", item: item, detail: item.item_detailable %>
    <% else %>
      <div class="absolute inset-0 bg-gray-100 p-2.5 flex items-end">
        <span class="text-[13px] font-extrabold leading-tight text-gray-800 line-clamp-3"><%= item.title %></span>
      </div>
    <% end %>
  <% end %>
  <% if badge %>
    <%# « Complet » : pastille encre avec coche, comme sur la fiche de l'item %>
    <span class="absolute bottom-1.5 right-1.5 h-[22px] pl-1.5 pr-2 rounded-full bg-ink text-white text-[10px] font-bold flex items-center gap-1 shadow-sm">
      <svg aria-hidden="true" class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg>
      <%= badge %>
    </span>
  <% end %>
</div>
