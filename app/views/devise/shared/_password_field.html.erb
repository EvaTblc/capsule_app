<%# Champ mot de passe des écrans d'entrée, avec le bouton œil pour afficher ce qu'on tape.
    Locaux : f, field, label, autocomplete, hint (facultatif, ex. « 6 caractères minimum » ou un lien), autofocus (facultatif) %>
<div data-controller="password-toggle">
  <div class="flex items-baseline justify-between gap-2 px-1 mb-1.5">
    <%= f.label field, label, class: "text-[13px] font-semibold text-stone-700" %>
    <% if local_assigns[:hint] %>
      <span class="text-[13px] text-gray-500"><%= hint %></span>
    <% end %>
  </div>
  <div class="relative">
    <%= f.password_field field, autocomplete: autocomplete, autofocus: local_assigns.fetch(:autofocus, false),
        placeholder: "••••••••", class: "#{entry_input_class} pr-12", data: { password_toggle_target: "input" } %>
    <button type="button" data-password-toggle-target="button" data-action="password-toggle#toggle"
            aria-label="Afficher le mot de passe" aria-pressed="false"
            class="absolute right-1 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center text-stone-500 hover:text-ink">
      <svg aria-hidden="true" class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
  </div>
</div>
