<%# Champs spécifiques VideoGameDetail %>
<div data-item-type-target="form" data-form="VideoGameDetail" class="hidden mb-4" data-controller="games-search">
  <%# Code-barres scanné, gardé avec l'item %>
  <%= f.hidden_field :barcode, data: { "games-search-target": "barcode" } %>
  <%# Jeu choisi via la recherche ou le scan : seul son identifiant part, le serveur relit l'œuvre chez IGDB %>
  <%= hidden_field_tag "product[igdb_id]", f.object.product&.igdb_id, id: nil, data: { "games-search-target": "igdbId" } %>

  <%= render "shared/game_search" %>

  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Titre</label>
    <input data-games-search-target="title" name="item[title]" placeholder="Titre de l'item..." value="<%= @item.title %>" class="w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200">
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Description</label>
    <textarea data-games-search-target="description" name="video_game_detail[description]" placeholder="Description..." rows="3" class="w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200 resize-none"><%= video_game_detail&.description %></textarea>
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">État</label>
    <%= f.select :condition, Item::CONDITIONS,
        { include_blank: "Sélectionner..." },
        class: "w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200" %>
  </div>
  <div class="mb-6">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Date d'acquisition</label>
    <%= f.date_field :acquired_at, class: "w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200" %>
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Plateforme</label>
    <input type="hidden" data-games-search-target="platform" name="video_game_detail[platform]" value="<%= video_game_detail&.platform %>">
    <div class="flex flex-wrap gap-2">
      <% VideoGameDetail::MAIN_PLATFORMS.each do |platform| %>
        <button type="button"
                data-platform="<%= platform %>"
                data-action="click->games-search#selectPlatform"
                class="h-9 px-4 rounded-full text-sm font-semibold border border-gray-200 text-gray-500 hover:border-purple-400 hover:text-purple-600 transition-colors duration-200 <%= video_game_detail&.platform == platform ? 'bg-purple-100 border-purple-400 text-purple-600' : 'bg-white' %>">
          <%= platform %>
        </button>
      <% end %>
      <select data-games-search-target="platformList" data-action="change->games-search#selectFromList" class="mt-2 w-full h-11 border-[1.5px] border-stone-200 rounded-full px-4 text-sm text-stone-700 bg-white focus:outline-none focus:border-purple-600">
        <%= grouped_options_for_select(VideoGameDetail::PLATFORM_GROUPS, video_game_detail&.platform,
                                      prompt: "Autres plateformes…") %>
      </select>
    </div>
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Genre</label>
    <input data-games-search-target="genre" name="video_game_detail[genre]" placeholder="Genre" value="<%= video_game_detail&.genre %>" class="w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200">
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Développeur</label>
    <input data-games-search-target="developer" name="video_game_detail[developer]" placeholder="Développeur" value="<%= video_game_detail&.developer %>" class="w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200">
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Édition</label>
    <input data-games-search-target="edition" name="video_game_detail[edition]" placeholder="Standard, Collector, Steelbook..." value="<%= video_game_detail&.edition %>" class="w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200">
  </div>
  <div class="mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Année de sortie</label>
    <input data-games-search-target="releaseDate" name="video_game_detail[release_date]" type="number" value="<%= video_game_detail&.release_date %>" class="w-full border-[1.5px] border-stone-200 rounded-2xl bg-white px-4 py-3 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200">
  </div>

  <div class="mb-4 flex items-center gap-3">
    <input type="checkbox" name="video_game_detail[completed]" id="completed" value="1"
          <%= "checked" if video_game_detail&.completed? %>
          role="switch" class="appearance-none shrink-0 w-11 h-[26px] rounded-full bg-gray-300 relative cursor-pointer transition-colors checked:bg-purple-700 before:content-[''] before:absolute before:top-[3px] before:left-[3px] before:w-5 before:h-5 before:rounded-full before:bg-white before:transition-transform checked:before:translate-x-[18px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600">
    <label for="completed" class="text-sm font-semibold text-stone-700 cursor-pointer">Jeu complet avec notice&nbsp;?</label>
  </div>
</div>
