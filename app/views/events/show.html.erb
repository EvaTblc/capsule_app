<%# Détail d'un événement (style « Pilule ») : en-tête rose (date, titre, quand), Modifier / Supprimer,
    carte et trajet, adresse, lien, commentaire, puis le partage avec un ami %>
<% card = "bg-white rounded-3xl shadow-[0_1px_2px_rgba(30,27,46,0.06)]" %>
<% friends = current_user.accepted_friends.to_a %>
<div class="min-h-screen bg-paper px-5 pt-[68px] pb-24 text-ink">
  <%= link_to carnet_path,
      class: "inline-flex items-center gap-1 h-10 pl-2.5 pr-3.5 rounded-full bg-white border-[1.5px] border-stone-200 text-sm font-bold" do %>
    <svg aria-hidden="true" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M15 19l-7-7 7-7"/></svg>
    Mon Carnet
  <% end %>

  <%# En-tête : la date en pavé, le titre, quand c'est, et le rappel %>
  <section class="mt-4 bg-red-100 rounded-[28px] p-4 flex items-center gap-3.5">
    <% if @event.date %>
      <span class="w-[58px] h-16 shrink-0 rounded-[18px] bg-white flex flex-col items-center justify-center leading-none text-red-700">
        <span class="text-2xl font-extrabold"><%= @event.date.day %></span>
        <span class="mt-1 text-[11px] font-extrabold tracking-wider uppercase"><%= I18n.l(@event.date, format: "%b") %></span>
      </span>
    <% end %>
    <div class="flex-1 min-w-0">
      <% if @event.date %>
        <p class="text-[11px] font-extrabold tracking-wider uppercase text-red-800">
          <%= I18n.l(@event.date, format: "%A %-d %B") %> · <%= event_countdown(@event.date) %>
        </p>
      <% end %>
      <h1 class="mt-0.5 text-[22px] font-extrabold tracking-tight leading-tight break-words"><%= @event.title %></h1>
      <% if @event.reminder? %>
        <p class="mt-1.5 inline-flex items-center gap-1 h-6 px-2.5 rounded-full bg-white text-xs font-bold text-purple-700">
          <svg aria-hidden="true" class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
          Rappel activé
        </p>
      <% end %>
    </div>
  </section>

  <%# Modifier / Supprimer %>
  <div class="mt-3 flex gap-2">
    <%= link_to edit_event_path(@event),
        class: "flex-1 h-12 rounded-full bg-white border-[1.5px] border-stone-200 text-[15px] font-bold flex items-center justify-center gap-2" do %>
      <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg>
      Modifier
    <% end %>
    <%= button_to event_path(@event), method: :delete, aria: { label: "Supprimer l'événement" },
        form: { data: { turbo_confirm: "Supprimer cet événement ?" } },
        class: "w-12 h-12 rounded-full bg-white border-[1.5px] border-red-200 text-red-700 flex items-center justify-center cursor-pointer" do %>
      <svg aria-hidden="true" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 002 2h8a2 2 0 002-2l1-12M9 7V4h6v3"/></svg>
    <% end %>
  </div>

  <div class="mt-6 flex flex-col gap-3">
    <%# Carte, et trajet depuis mon adresse (durée et distance calculées par la carte) %>
    <% if @event.latitude.present? && @event.longitude.present? %>
      <div class="w-full h-52 rounded-3xl overflow-hidden"
           data-controller="map"
           data-map-api-key-value="<%= mapbox_public_token %>"
           data-map-markers-value="<%= [ { lat: @event.latitude, lng: @event.longitude, color: '#7e22ce', label: @event.title } ].to_json %>"
           data-map-directions-value="<%= current_user.latitude.present? && current_user.longitude.present? %>"
           data-map-user-lat-value="<%= current_user.latitude %>"
           data-map-user-lng-value="<%= current_user.longitude %>">
      </div>
      <% if current_user.latitude.present? %>
        <div id="route-info" aria-live="polite" class="self-start h-9 px-4 rounded-full bg-lilac text-purple-800 text-sm font-bold flex items-center gap-2">
          <span class="text-stone-600 font-medium">Calcul du trajet…</span>
        </div>
      <% end %>
    <% end %>

    <%# Adresse, lien, commentaire %>
    <% if @event.address.present? || @event.url.present? || @event.comment.present? %>
      <div class="<%= card %> px-4 py-1 divide-y divide-stone-100">
        <% if @event.address.present? %>
          <div class="py-3 flex items-center gap-3">
            <span aria-hidden="true" class="w-9 h-9 shrink-0 rounded-full bg-lilac text-purple-700 flex items-center justify-center">
              <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            </span>
            <p class="flex-1 min-w-0 text-sm font-medium break-words"><%= @event.address %></p>
          </div>
        <% end %>
        <% if @event.url.present? %>
          <%= link_to @event.url, target: "_blank", rel: "noopener", class: "py-3 flex items-center gap-3" do %>
            <span aria-hidden="true" class="w-9 h-9 shrink-0 rounded-full bg-lilac text-purple-700 flex items-center justify-center">
              <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M18 14v4a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2h4"/></svg>
            </span>
            <span class="flex-1 text-sm font-bold text-purple-700">Voir l'annonce</span>
          <% end %>
        <% end %>
        <% if @event.comment.present? %>
          <p class="py-3 text-sm leading-relaxed whitespace-pre-wrap"><%= @event.comment %></p>
        <% end %>
      </div>
    <% end %>

    <%# Partager avec un ami : une copie de l'événement arrive dans son carnet %>
    <% if friends.any? %>
      <section class="mt-3">
        <h2 class="mb-2 text-[17px] font-extrabold">Partager avec</h2>
        <div id="share-event-<%= @event.id %>" class="flex flex-wrap gap-2">
          <% friends.each do |friend| %>
            <%= button_to share_event_path(@event), params: { friend_id: friend.id }, method: :post,
                class: "h-11 pl-1.5 pr-4 rounded-full bg-white border-[1.5px] border-stone-200 text-sm font-bold flex items-center gap-2 cursor-pointer active:scale-95 transition-transform" do %>
              <%= person_avatar(friend, size: "w-8 h-8 text-xs") %>
              <%= friend.email.split("@").first %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
