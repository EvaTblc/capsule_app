  <div class="relative mb-4">
    <label class="text-[13px] font-semibold text-stone-700 mb-1.5 px-1 block">Recherche</label>
    <div class="flex gap-2">
      <input data-games-search-target="query"
            data-action="input->games-search#search"
            placeholder="Rechercher un jeu..."
            class="flex-1 min-w-0 h-12 border-[1.5px] border-purple-300 rounded-full bg-white px-4 text-base text-ink placeholder:text-gray-500 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-200">
      <%# Scan : UPCitemdb, payant au-delà de l'essai → verrouillé pour un compte free %>
      <% if current_user.paid_features? %>
      <button type="button"
              data-action="click->games-search#startScan"
              class="w-12 h-12 bg-purple-700 rounded-full flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </button>
      <% else %>
        <%= render layout: "shared/premium_lock", locals: { button_class: "w-12 h-12 bg-stone-200 rounded-full flex items-center justify-center", wrapper_class: "shrink-0" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="absolute -top-1 -right-1 text-xs">🔒</span>
        <% end %>
      <% end %>
    </div>
    <div data-games-search-target="results" class="hidden absolute z-20 w-full bg-white border border-stone-100 rounded-2xl shadow-lg mt-1 max-h-64 overflow-y-auto"></div>
  </div>

  <%# Scanner modal %>
  <div data-games-search-target="scanner" class="hidden fixed inset-0 z-50 bg-black flex flex-col">
    <div class="flex justify-between items-center p-4">
      <p class="text-white font-semibold">Scanner un jeu</p>
      <button type="button" data-action="click->games-search#stopScan" class="text-white text-2xl">✕</button>
    </div>
    <div class="flex-1 relative">
      <%# playsinline + muted : sans eux, l'iPhone ouvre la vidéo en plein écran ou ne la lance pas %>
      <video id="game-scanner-video" class="w-full h-full object-cover" playsinline muted autoplay></video>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="border-2 border-purple-400 w-64 h-32 rounded-lg"></div>
      </div>
    </div>
  </div>
