<%= render layout: "shared/entry", locals: { tagline: "Jeux, BD, vinyles, figurines : toute ta collec'." } do %>
  <h1 class="text-[28px] font-extrabold tracking-tight leading-tight">On reprend la collec'&nbsp;?</h1>

  <%= render "devise/shared/google_button" %>

  <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), local: true, class: "flex flex-col gap-3.5") do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: entry_label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "toi@exemple.fr", class: entry_input_class %>
    </div>

    <%= render "devise/shared/password_field", f: f, field: :password, label: "Mot de passe", autocomplete: "current-password",
               hint: link_to("Oublié ?", new_user_password_path, class: entry_link_class) %>

    <label class="flex items-center gap-2 min-h-10 text-sm text-stone-700">
      <%= f.check_box :remember_me, checked: true, class: "w-[18px] h-[18px] accent-purple-700" %>
      Rester connecté
    </label>

    <%= entry_submit(f, "Ouvrir ma capsule") %>
  <% end %>

  <p class="mt-1 text-center text-sm text-stone-600">
    Nouveau ici&nbsp;? <%= link_to "Crée ta capsule", new_user_registration_path, class: entry_link_class %>
  </p>
<% end %>
