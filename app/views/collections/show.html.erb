<div class="p-4 pb-24">

  <% style = Collection::CATEGORY_STYLES[@collection.category] %>

  <div class="rounded-3xl mt-14 mb-4 relative overflow-hidden <%= @collection.cover_image.attached? ? 'h-48' : style %>"
      style="<%= @collection.cover_image.attached? ? "background-image: url('#{url_for(@collection.cover_image)}'); background-size: cover; background-position: center;" : "" %>">

    <% if @collection.cover_image.attached? %>
      <div class="absolute inset-0 bg-black opacity-40 rounded-3xl"></div>
    <% end %>

    <div class="relative z-10 h-full flex flex-col justify-between p-6">

      <div>
        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-3">
          <% category_to_icon = { "comics" => "comics", "movies" => "movies", "music" => "music", "video_games" => "video_games", "figurines" => "figurines", "trading_cards" => "trading_cards", "board_games" => "board_games", "books" => "book", "mixed" => "mixed", "other" => "other" } %>
          <%= render "collections/icons/#{category_to_icon[@collection.category]}" %>      </div>
        <p class="text-xs font-semibold uppercase tracking-widest <%= @collection.cover_image.attached? ? 'text-white opacity-75' : 'text-gray-400' %>"><%= category_label(@collection.category) %></p>
        <div class="flex items-center justify-between gap-2">
          <h1 class="text-3xl font-black tracking-tight <%= @collection.cover_image.attached? ? 'text-white' : '' %>"><%= @collection.title %></h1>
          <div class="flex items-center gap-2 shrink-0">
            <%# Édition et lien d'invitation : propriétaire uniquement (le lien d'invitation fait devenir membre) %>
            <% if @owner %>
            <%= link_to edit_collection_path(@collection), class: "w-9 h-9 bg-white rounded-xl flex items-center justify-center shadow-sm" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            <% end %>

            <button data-controller="share"
                    data-share-url-value="<%= invite_url(token: @collection.invite_token) %>"
                    data-action="click->share#copy"
                    class="w-9 h-9 bg-white rounded-xl flex items-center justify-center shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
            </button>
            <% end %>
          </div>
        </div>
        <p class="text-sm <%= @collection.cover_image.attached? ? 'text-white opacity-75' : 'text-gray-400' %>"><%= items_count(@collection.items.count) %></p>

      </div>
    </div>

  </div>
  <%= link_to collections_path, class: "flex items-center gap-1 text-xs text-gray-400 mb-3" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    MES COLLECTIONS
  <% end %>

  <div data-controller="collection-filter">

    <%# Recherche (instantanée, dans la page) et choix grille / liste, retenu par le navigateur %>
    <div class="flex items-center gap-2 mb-3">
      <label class="flex-1 min-w-0 h-11 rounded-xl bg-gray-100 flex items-center gap-2 px-3">
        <svg class="w-[18px] h-[18px] text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input type="search"
              placeholder="Chercher dans <%= @collection.title %>…"
              aria-label="Chercher dans la collection"
              data-collection-filter-target="search"
              data-action="input->collection-filter#filter"
              class="flex-1 min-w-0 bg-transparent border-0 p-0 text-[15px] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-0">
      </label>
      <div class="flex rounded-xl bg-gray-100 p-[3px] gap-0.5 shrink-0" role="group" aria-label="Affichage">
        <button type="button" aria-label="Vue grille" aria-pressed="true"
                data-collection-filter-target="gridButton" data-action="collection-filter#showGrid"
                class="w-[38px] h-[38px] rounded-[9px] flex items-center justify-center text-gray-500 aria-pressed:bg-white aria-pressed:text-purple-700 aria-pressed:shadow-sm">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>
        </button>
        <button type="button" aria-label="Vue liste" aria-pressed="false"
                data-collection-filter-target="listButton" data-action="collection-filter#showList"
                class="w-[38px] h-[38px] rounded-[9px] flex items-center justify-center text-gray-500 aria-pressed:bg-white aria-pressed:text-purple-700 aria-pressed:shadow-sm">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg>
        </button>
      </div>
    </div>

    <% unless @items.empty? %>
      <%# Filtres rapides : un seul choix à la fois (« Tous » pour revenir), plus « Complets » qui s'y ajoute %>
      <% facets = collection_facets(@items, @collection.category) %>
      <% completable = collection_completable?(@items) %>
      <% chip = "h-8 px-3.5 rounded-full text-[13px] font-semibold whitespace-nowrap shrink-0 border border-gray-200 bg-white text-gray-700 aria-pressed:bg-purple-700 aria-pressed:border-purple-700 aria-pressed:text-white" %>
      <% if facets.any? || completable %>
        <div class="flex gap-2 overflow-x-auto -mx-4 px-4 pb-1 mb-2 [scrollbar-width:none]" role="group" aria-label="Filtres rapides">
          <button type="button" class="<%= chip %>" aria-pressed="true"
                  data-collection-filter-target="facetChip" data-facet="" data-action="collection-filter#pickFacet">Tous</button>
          <% facets.each do |facet| %>
            <button type="button" class="<%= chip %>" aria-pressed="false"
                    data-collection-filter-target="facetChip" data-facet="<%= facet %>" data-action="collection-filter#pickFacet"><%= facet %></button>
          <% end %>
          <% if completable %>
            <button type="button" class="<%= chip %>" aria-pressed="false"
                    data-collection-filter-target="completeChip" data-action="collection-filter#toggleComplete">Complets</button>
          <% end %>
        </div>
      <% end %>

      <%# Nombre d'items affichés, et tri (retenu par le navigateur) %>
      <div class="flex items-center justify-between gap-3 mb-3">
        <span class="text-[13px] text-gray-500" data-collection-filter-target="count" aria-live="polite"><%= items_count(@items.size) %></span>
        <label class="flex items-center gap-1 text-[13px] font-semibold text-gray-700">
          <span class="sr-only">Trier par</span>
          <select data-collection-filter-target="sort" data-action="collection-filter#sort"
                  class="appearance-none bg-transparent border-0 p-0 pr-5 text-[13px] font-semibold text-gray-700 text-right focus:outline-none focus:ring-0 bg-no-repeat bg-right"
                  style="background-image: url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23374151' stroke-width='2.5' stroke-linecap='round'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E&quot;); background-size: 14px;">
            <%= options_for_select(collection_sort_options(@collection.category), "title") %>
          </select>
        </label>
      </div>
    <% end %>

    <% if @items.empty? %>
      <div class="flex flex-col items-center justify-center py-16 gap-4 text-center">
        <div class="w-16 h-16 bg-purple-50 rounded-2xl flex items-center justify-center">
          <%# Version figée + empreinte SRI : le navigateur refuse le script si son contenu change %>
          <script src="https://unpkg.com/@lottiefiles/lottie-player@2.0.12/dist/lottie-player.js"
                  integrity="sha384-i8zT4p4C0XG4mPhfz0zuffZpppP8NjlttNsP6srEdEBatwZkcYUBoQtAW7sfKEp2"
                  crossorigin="anonymous"></script>

          <lottie-player
            src="/empty.json"
            background="transparent"
            speed="1"
            style="width: 200px; height: 200px;"
            loop
            autoplay>
          </lottie-player>

        </div>
        <div>
          <p class="text-sm font-semibold text-gray-700 mb-1">Collection vide</p>
          <p class="text-xs text-gray-400">Ajoute ton premier item pour commencer.</p>
        </div>

      </div>
    <% else %>
      <%# Grille par défaut (3 colonnes), ou liste compacte : data-view, changé par collection-filter %>
      <div data-collection-filter-target="list" data-view="grid"
           class="group mb-6 data-[view=grid]:grid data-[view=grid]:grid-cols-3 data-[view=grid]:gap-x-2.5 data-[view=grid]:gap-y-4 data-[view=list]:flex data-[view=list]:flex-col">
        <% @items.each_with_index do |item, position| %>
          <%= render "collections/item_card", item: item, collection: @collection, position: position %>
        <% end %>
      </div>
    <% end %>

    <%# Membres : qui a accès à la collection. Le propriétaire gère le lien et retire des membres %>
    <% if @member %>
      <div class="mb-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Membres</h2>
        <div class="bg-white border border-gray-100 rounded-xl divide-y divide-gray-50">
          <% @members.each do |membership| %>
            <div class="px-4 py-3 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center shrink-0">
                <span class="text-purple-600 font-bold text-xs"><%= membership.user.email[0].upcase %></span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate">
                  <%= membership.user.email.split("@").first %>
                  <% if membership.user_id == current_user.id %><span class="text-gray-400 font-normal">(toi)</span><% end %>
                </p>
                <p class="text-xs text-gray-400"><%= membership.role == "owner" ? "Propriétaire" : "Membre" %></p>
              </div>
              <% if membership.role != "owner" && (@owner || membership.user_id == current_user.id) %>
                <%= button_to membership.user_id == current_user.id ? "Quitter" : "Retirer",
                    collection_membership_path(@collection, membership),
                    method: :delete,
                    form: { data: { turbo_confirm: membership.user_id == current_user.id ? "Quitter cette collection ?" : "Retirer #{membership.user.email} de la collection ?" } },
                    class: "text-xs text-red-400 font-semibold" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @owner %>
          <div class="mt-2 bg-gray-50 rounded-xl px-4 py-3 flex items-center justify-between gap-3">
            <p class="text-xs text-gray-500">
              Toute personne qui a le lien d'invitation peut rejoindre la collection et la modifier.
            </p>
            <%= button_to "Nouveau lien", regenerate_invite_collection_path(@collection),
                method: :patch,
                form: { data: { turbo_confirm: "Créer un nouveau lien ? L'ancien ne fonctionnera plus (les membres actuels gardent leur accès)." } },
                class: "text-xs text-purple-600 font-semibold whitespace-nowrap" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Les notes sont personnelles aux membres : jamais montrées aux visiteurs %>
    <% if @member && @collection.notes.any? %>
      <div class="mb-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Notes</h2>
        <div class="flex flex-col gap-2">
          <% @collection.notes.each do |note| %>
            <%= link_to note_path(note) do %>
              <div class="bg-white border border-gray-100 rounded-xl px-4 py-3 flex items-center gap-3 active:scale-95 transition-transform duration-150">
                <div class="w-8 h-8 rounded-xl <%= note.reminder? ? 'bg-purple-50' : 'bg-gray-50' %> flex items-center justify-center shrink-0">
                  <% if note.reminder? %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
                    </svg>
                  <% else %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-900 truncate"><%= note.title %></p>
                  <p class="text-xs text-gray-400 truncate"><%= note.comment&.truncate(40) %></p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= link_to "https://www.vinted.fr/catalog?search_text=#{URI.encode_www_form_component(@collection.title)}",
        target: "_blank",
        rel: "noopener",
        class: "btn-vinted" do %>
      <%= image_tag "vinted-logo.svg", size: "50x50" %> Trouver des Pépites
    <% end %>
  </div>

<%# Boutons d'ajout : membres uniquement %>
<% if @member %>
<div data-controller="quick-add">
  <% if @collection.category == "video_games" %>
    <%# Bouton éclair %>
    <button data-action="click->quick-add#open"
            class="fixed bottom-24 right-24 z-10 bg-white border-2 border-purple-600 text-purple-600 w-14 h-14 rounded-full flex items-center justify-center shadow-lg active:scale-95 transition-transform duration-150">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </button>

    <%# Panel %>
    <div data-quick-add-target="panel" class="hidden fixed inset-0 z-50 flex flex-col justify-end">
      <div class="absolute inset-0 bg-black opacity-40" data-action="click->quick-add#close"></div>
      <div class="relative bg-white rounded-t-3xl p-6 pb-10 z-10 overflow-y-auto max-h-[80vh]" data-controller="games-search game-pile" data-action="games-search:chosen->game-pile#add"
      data-game-pile-collection-value="<%= @collection.id %>"
      data-game-pile-platforms-value="<%= VideoGameDetail::PLATFORMS.to_json%>"
      data-game-pile-url-value="<%= collection_items_path(@collection) %>"
      data-game-pile-owned-value="<%= owned_games(@collection).to_json %>">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-black">Ajouter des jeux</h2>
          <button data-action="click->quick-add#close" class="text-gray-400 text-xl">✕</button>
        </div>

        <div data-game-pile-target="list" class="flex flex-col gap-2 mb-4"></div>
        <button type="button" data-game-pile-target="submit" data-action="game-pile#submit"
        class="hidden w-full bg-purple-600 text-white py-3 rounded-xl font-semibold text-sm mb-4"></button>

          <div class="relative">
            <input data-games-search-target="query"
                  data-action="input->games-search#search"
                  placeholder="Rechercher un jeu..."
                  class="w-full border border-purple-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-400">
            <div data-games-search-target="results"
                class="hidden z-20 w-full bg-white border border-gray-100 rounded-xl shadow-lg max-h-48 overflow-y-auto"></div>
          </div>
      </div>
    </div>
  <% end %>

  <%= link_to new_collection_item_path(@collection), class: "fixed bottom-24 right-6 z-10 bg-purple-600 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg shadow-purple-300 active:scale-95 transition-transform duration-150" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
  <% end %>
</div>
<% end %>
