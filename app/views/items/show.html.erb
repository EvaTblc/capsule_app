<%# Fiche d'un item (style « Pilule ») : en haut, sur la couleur du type, la jaquette penchée et le titre avec ses pastilles ;
    dessous, les infos en liste, le résumé, le commentaire, les photos, puis les actions %>
<div class="min-h-screen bg-paper pt-14 pb-24 text-ink">
  <%= turbo_stream_from @item %>
  <% header_image = @item.images.attached? ? url_for(@item.images.first) : item_cover_url(@item, size: :cover_big_2x) %>

  <section class="<%= item_page_tint(@item) %> rounded-b-[36px] px-5 pt-3 pb-6">
    <%= link_to collection_path(@item.collection),
        class: "inline-flex max-w-full items-center gap-1 h-10 pl-2.5 pr-3.5 mb-4 rounded-full bg-white text-sm font-bold" do %>
      <svg aria-hidden="true" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M15 19l-7-7 7-7"/></svg>
      <span class="truncate"><%= @item.collection.title %></span>
    <% end %>

    <div class="flex gap-4 items-end">
      <% if header_image %>
        <%# Photo de l'utilisatrice en priorité, sinon jaquette du catalogue. Décorative : le titre est juste à côté %>
        <img src="<%= header_image %>" alt="" class="w-32 h-[170px] shrink-0 rounded-2xl object-cover bg-white -rotate-3 shadow-[0_14px_30px_rgba(30,27,46,0.22)]">
      <% else %>
        <div class="w-32 h-[170px] shrink-0 rounded-2xl bg-white/70 -rotate-3 flex items-center justify-center">
          <%= render "collections/icons/#{Item::TYPE_TO_ICON[@item.item_detailable_type]}" %>
        </div>
      <% end %>

      <div class="flex-1 min-w-0 flex flex-col gap-2 pb-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-700"><%= item_type_label(@item.item_type) %></p>
        <h1 class="text-[25px] font-extrabold tracking-tight leading-[1.05] break-words"><%= @item.title %></h1>
        <% chips = item_page_chips(@item) %>
        <% if chips.any? %>
          <div class="flex flex-wrap gap-1.5">
            <% chips.each do |chip| %>
              <% case chip[:kind] %>
              <% when :band %>
                <span class="h-7 px-3 rounded-full text-xs font-bold text-white flex items-center" style="background-color: <%= chip[:color] %>"><%= chip[:label] %></span>
              <% when :ink %>
                <span class="h-7 pl-2 pr-3 rounded-full bg-ink text-xs font-bold text-white flex items-center gap-1">
                  <svg aria-hidden="true" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg>
                  <%= chip[:label] %>
                </span>
              <% else %>
                <span class="h-7 px-3 rounded-full bg-white text-xs font-semibold flex items-center"><%= chip[:label] %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <div class="px-5 pt-5 flex flex-col gap-3">
    <%# summary_en : résumé anglais brut (source de TranslationJob). Affiché seulement à défaut de description
        française : jeu ajouté par un compte free (pas de traduction), ou traduction échouée %>
    <% attributes = @item.item_detailable.attributes.except("id", "created_at", "updated_at") %>
    <% english_only = attributes["description"].blank? && attributes["summary_en"].present? %>
    <% description = english_only ? attributes["summary_en"] : attributes["description"] %>
    <%# Pastilles déjà montrées en haut, résumé dans sa propre carte : le reste en liste %>
    <% fields = attributes.except("summary_en", "description", *item_chip_fields(@item)) %>
    <% fields = fields.sort_by { |key, _value| VideoGameDetail::SHOW_ORDER.index(key) || VideoGameDetail::SHOW_ORDER.size } if @item.item_detailable.is_a?(VideoGameDetail) %>
    <% fields = fields.reject { |_key, value| value.nil? || value == "" } %>

    <% if fields.any? %>
      <div class="bg-white rounded-3xl px-[18px] py-1 shadow-[0_1px_2px_rgba(30,27,46,0.06)]">
        <% fields.each do |key, value| %>
          <div class="flex justify-between items-baseline gap-4 py-[11px] border-b border-stone-100 last:border-0 text-sm">
            <p class="text-stone-600 shrink-0"><%= key == "release_date" ? "Année de sortie" : t("show.#{@item.item_type.underscore}.#{key}", default: key.humanize) %></p>
            <%# Oui / non (édition limitée...) plutôt que « true » / « false » %>
            <p class="font-bold text-right break-words min-w-0"><%= [ true, false ].include?(value) ? (value ? "Oui" : "Non") : value %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if description.present? %>
      <div class="bg-white rounded-3xl px-[18px] py-3.5 shadow-[0_1px_2px_rgba(30,27,46,0.06)]" data-controller="expandable">
        <h2 class="text-base font-extrabold mb-1">Résumé<%= " (en anglais)" if english_only %></h2>
        <p class="text-sm leading-relaxed text-stone-700 line-clamp-3" data-expandable-target="content"><%= description %></p>
        <button data-expandable-target="button" data-action="click->expandable#toggle" class="mt-1 text-[13px] font-bold text-purple-800">Voir plus</button>
        <%# Résumé repris de Wikipédia (et non retouché) : la licence CC BY-SA impose de citer la source %>
        <% if @item.product&.description_source == "wikipedia" && description == @item.product.description %>
          <%= link_to "Résumé : Wikipédia (CC BY-SA)", @item.product.details["wikipedia_url"],
              target: "_blank", rel: "noopener", class: "block mt-1 text-xs text-gray-500" %>
        <% end %>
      </div>
    <% end %>

    <% if @item.comment.present? %>
      <div class="bg-white rounded-3xl px-[18px] py-3.5 shadow-[0_1px_2px_rgba(30,27,46,0.06)]">
        <h2 class="text-base font-extrabold mb-1">Commentaire</h2>
        <p class="text-sm leading-relaxed text-stone-700"><%= @item.comment %></p>
      </div>
    <% end %>

  <% if @item.images.attached? %>
    <div class="grid grid-cols-2 gap-2" data-controller="lightbox">

      <%# Modal %>
      <div data-lightbox-target="modal" class="hidden fixed inset-0 z-50 bg-black flex items-center justify-center"
          data-action="click->lightbox#close">

        <button data-action="click->lightbox#prev:stop"
                class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white rounded-full flex items-center justify-center z-10">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <img data-lightbox-target="image" src="" class="max-w-full max-h-full object-contain">

        <button data-action="click->lightbox#next:stop"
                class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white rounded-full flex items-center justify-center z-10">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <button class="absolute top-4 right-4 text-white text-2xl z-10"
                data-action="click->lightbox#close:stop">✕</button>
      </div>

      <%# Photos %>
      <% @item.images.each do |image| %>
        <div class="h-40 rounded-3xl overflow-hidden cursor-pointer"
            data-action="click->lightbox#open"
            data-url="<%= url_for(image) %>">
          <%= image_tag image, class: "w-full h-full object-cover" %>
        </div>
      <% end %>

    </div>
  <% end %>
    <%# Actions : membres uniquement (comme côté serveur). Estimation : appel payant à Claude, verrouillée pour un compte free ;
        son résultat remplace le contenu de #estimation %>
    <% if @member %>
      <div class="flex flex-wrap gap-2.5 pt-1">
        <%= link_to "Modifier", edit_collection_item_path(@collection, @item),
            class: "flex-1 h-14 rounded-full bg-ink text-white text-base font-bold flex items-center justify-center hover:bg-black" %>
        <%# Une fois estimée, la carte du résultat prend toute la largeur, sous « Modifier » %>
        <div id="estimation" class="flex-1 min-w-0 has-[.estimation-card]:basis-full">
          <% if current_user.paid_features? %>
            <%= button_to "Estimer la valeur", estimate_item_path(@item), class: "btn-estimate" %>
          <% else %>
            <%= render layout: "shared/premium_lock", locals: { button_class: "btn-estimate" } do %>
              🔒 Estimer la valeur
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
