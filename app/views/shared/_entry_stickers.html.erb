<%# Décor des écrans d'entrée : autocollants d'objets de collection (vinyle, console, livre, carte), purement décoratifs %>
<div aria-hidden="true" class="pointer-events-none">
  <%# Vinyle %>
  <div style="position: absolute; top: 26px; left: 14px; width: 88px; height: 88px; border-radius: 50%; background: #1e1b2e; box-shadow: 4px 4px 0 #7e22ce; transform: rotate(-12deg); display: flex; align-items: center; justify-content: center">
    <div style="width: 66px; height: 66px; border-radius: 50%; border: 1.5px solid #3f3a52; display: flex; align-items: center; justify-content: center">
      <div style="width: 30px; height: 30px; border-radius: 50%; background: #f472b6; display: flex; align-items: center; justify-content: center"><div style="width: 6px; height: 6px; border-radius: 50%; background: #1e1b2e"></div></div>
    </div>
  </div>

  <%# Console portable %>
  <div style="position: absolute; top: 22px; right: 22px; width: 66px; height: 78px; border-radius: 8px 8px 14px 14px; background: #fbbf24; border: 2.5px solid #1e1b2e; box-shadow: 4px 4px 0 #1e1b2e; transform: rotate(11deg); box-sizing: border-box; padding: 8px 7px; display: flex; flex-direction: column; gap: 6px">
    <div style="height: 34px; border-radius: 4px; background: #ffffff; border: 2px solid #1e1b2e"></div>
    <div style="display: flex; gap: 4px; justify-content: center"><div style="width: 6px; height: 10px; background: #1e1b2e; border-radius: 1px"></div><div style="width: 6px; height: 10px; background: #1e1b2e; border-radius: 1px"></div><div style="width: 6px; height: 10px; background: #1e1b2e; border-radius: 1px"></div></div>
  </div>

  <%# Livre %>
  <div style="position: absolute; top: 150px; left: 22px; width: 50px; height: 78px; border-radius: 4px 10px 10px 4px; background: #2dd4bf; border: 2.5px solid #1e1b2e; box-shadow: 4px 4px 0 #1e1b2e; transform: rotate(-9deg); box-sizing: border-box; display: flex">
    <div style="width: 10px; border-right: 2.5px solid #1e1b2e; background: #0f766e"></div>
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 5px; padding: 0 6px"><div style="height: 3px; background: #1e1b2e; border-radius: 2px"></div><div style="height: 3px; width: 70%; background: #1e1b2e; border-radius: 2px"></div></div>
  </div>

  <%# Carte à collectionner %>
  <div style="position: absolute; top: 140px; right: 24px; width: 56px; height: 78px; border-radius: 8px; background: #f472b6; border: 2.5px solid #1e1b2e; box-shadow: 4px 4px 0 #1e1b2e; transform: rotate(13deg); box-sizing: border-box; padding: 5px; display: flex">
    <div style="flex: 1; border-radius: 4px; border: 2px solid #1e1b2e; background: #fdf2f8; display: flex; align-items: center; justify-content: center">
      <svg width="24" height="24" viewBox="0 0 24 24"><path d="M12 2.5l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 16.7 6.2 20l1.4-6.4L2.7 9.2l6.5-.7z" fill="#fbbf24" stroke="#1e1b2e" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <svg width="20" height="20" viewBox="0 0 24 24" style="position: absolute; top: 120px; left: 110px"><path d="M12 2v20M2 12h20" stroke="#7e22ce" stroke-width="3" stroke-linecap="round"/></svg>
  <svg width="16" height="16" viewBox="0 0 24 24" style="position: absolute; top: 110px; right: 112px"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z" fill="#fbbf24" stroke="#1e1b2e" stroke-width="2" stroke-linejoin="round"/></svg>
</div>
