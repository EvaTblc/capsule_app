<%# Nouvel événement (style « Pilule ») : retour au carnet, titre, puis le formulaire %>
<div class="min-h-screen bg-paper px-5 pt-[68px] pb-24 text-ink">
  <%= link_to carnet_path,
      class: "inline-flex items-center gap-1 h-10 pl-2.5 pr-3.5 rounded-full bg-white border-[1.5px] border-stone-200 text-sm font-bold" do %>
    <svg aria-hidden="true" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M15 19l-7-7 7-7"/></svg>
    Mon Carnet
  <% end %>
  <h1 class="mt-4 mb-6 text-[30px] font-extrabold tracking-tight leading-none">Nouvel événement</h1>

  <%= render "form", event: @event %>
</div>
