<%# Cadre des écrans d'entrée : bloc lilas avec le logo, puis le contenu de l'écran sur fond blanc cassé.
    Usage : render layout: "shared/entry", locals: { tagline: "…" } do … end %>
<% tagline = local_assigns.fetch(:tagline, nil) %>
<div class="min-h-dvh bg-paper text-ink">
  <div class="mx-auto w-full max-w-sm flex flex-col">
    <div class="relative mx-4 mt-4 h-[250px] rounded-[32px] bg-lilac overflow-hidden flex flex-col items-center justify-center gap-1">
      <%# Deux capsules en fond, rappel de la forme du logo %>
      <div aria-hidden="true" class="absolute w-[280px] h-[120px] rounded-full bg-purple-200/60 -rotate-[14deg] top-9 -left-[70px]"></div>
      <div aria-hidden="true" class="absolute w-[200px] h-[90px] rounded-full bg-purple-200/60 -rotate-[14deg] bottom-2 -right-14"></div>

      <%= image_tag "logo.svg", alt: "", class: "relative w-[92px] h-[92px] -rotate-[8deg]" %>
      <p class="relative font-display text-[44px] font-extrabold leading-[0.9]">capsule</p>
      <% if tagline %>
        <p class="relative mt-1.5 px-4 text-[13px] font-medium text-[#4c3d6b] text-center"><%= tagline %></p>
      <% end %>
    </div>

    <div class="px-6 pt-6 pb-5 flex flex-col gap-3.5">
      <%= yield %>
    </div>
    <%= content_for(:entry_footer) %>
  </div>
</div>
